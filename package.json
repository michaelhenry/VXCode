{
  "name": "vxcode",
  "displayName": "VXCode",
  "description": "Build and run Apple apps directly from VS Code.",
  "version": "1.0.9",
  "publisher": "MichaelHenry19",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./build/src/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "workspaceContains:**/*.xcodeproj/project.pbxproj",
    "workspaceContains:**/*.xcworkspace/contents.xcworkspacedata",
    "onView:VXCode.launch"
  ],
  "scripts": {
    "test": "tsc -p tsconfig.json && node build/test/core.test.js && node build/test/sidebar.test.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"README.md\"",
    "package": "tsc -p tsconfig.json && python3 scripts/package.py",
    "install:local": "npm run package && code --install-extension \"$npm_package_name-$npm_package_version.vsix\" --force",
    "package:vsce": "npx @vscode/vsce package"
  },
  "contributes": {
    "commands": [
      {
        "command": "VXCode.selectProject",
        "title": "VXCode: Select Project or Workspace"
      },
      {
        "command": "VXCode.selectScheme",
        "title": "VXCode: Select Scheme"
      },
      {
        "command": "VXCode.selectSimulator",
        "title": "VXCode: Select Simulator"
      },
      {
        "command": "VXCode.selectConfiguration",
        "title": "VXCode: Select Build Configuration"
      },
      {
        "command": "VXCode.build",
        "title": "VXCode: Build"
      },
      {
        "command": "VXCode.run",
        "title": "VXCode: Build and Run"
      },
      {
        "command": "VXCode.launch",
        "title": "VXCode: Run Without Building"
      },
      {
        "command": "VXCode.cancel",
        "title": "VXCode: Cancel Current Operation"
      },
      {
        "command": "VXCode.showOutput",
        "title": "VXCode: Show Output"
      },
      {
        "command": "VXCode.test",
        "title": "VXCode: Test"
      },
      {
        "command": "VXCode.testWithoutBuilding",
        "title": "VXCode: Re-run Tests Without Building"
      },
      {
        "command": "VXCode.clean",
        "title": "VXCode: Clean Build Folder"
      },
      {
        "command": "VXCode.archive",
        "title": "VXCode: Archive"
      },
      {
        "command": "VXCode.toggleDebugger",
        "title": "VXCode: Toggle Debugger on Run"
      },
      {
        "command": "VXCode.selectDerivedData",
        "title": "VXCode: Set DerivedData Location"
      },
      {
        "command": "VXCode.packages",
        "title": "VXCode: Manage Package Dependencies"
      },
      {
        "command": "VXCode.resolvePackages",
        "title": "VXCode: Resolve Package Dependencies"
      },
      {
        "command": "VXCode.buildOptions",
        "title": "VXCode: Build Options"
      }
    ],
    "configuration": {
      "title": "VXCode",
      "properties": {
        "VXCode.configuration": {
          "type": "string",
          "default": "Debug",
          "description": "Xcode build configuration."
        },
        "VXCode.developerDirectory": {
          "type": "string",
          "default": "",
          "description": "Optional Xcode Contents/Developer path (DEVELOPER_DIR)."
        },
        "VXCode.derivedDataPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Custom DerivedData folder passed to `xcodebuild -derivedDataPath`. Supports `~` and `${workspaceFolder}`; relative paths resolve against the workspace folder. Leave empty to use a per-project folder in VXCode's extension storage."
        },
        "VXCode.discoveryExclude": {
          "type": "string",
          "default": "**/{node_modules,Pods,Carthage,.git,build,DerivedData}/**",
          "description": "Glob excluded from project discovery."
        },
        "VXCode.attachDebugger": {
          "type": "boolean",
          "default": false,
          "description": "Attach the Swift debugger (swiftlang.swift-vscode) when Build and Run launches the app."
        },
        "VXCode.buildOptimizations": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "noCodeCoverage",
              "lockPackages",
              "skipValidation",
              "noPreviews",
              "dwarf",
              "compilationCache",
              "parallelTesting",
              "noIndexStore",
              "timingSummary"
            ],
            "enumDescriptions": [
              "Pass -enableCodeCoverage NO when running tests.",
              "Pass -disableAutomaticPackageResolution (use Package.resolved as-is).",
              "Pass -skipPackagePluginValidation and -skipMacroValidation.",
              "Set ENABLE_PREVIEWS=NO and ENABLE_DEBUG_DYLIB=NO.",
              "Set DEBUG_INFORMATION_FORMAT=dwarf.",
              "Set COMPILATION_CACHE_ENABLE_CACHING=YES.",
              "Pass -parallel-testing-enabled YES when running tests.",
              "Set COMPILER_INDEX_STORE_ENABLE=NO.",
              "Pass -showBuildTimingSummary."
            ]
          },
          "markdownDescription": "Speedups applied to Build, Build and Run, Run tests and Clean (not Archive). Edit them in **VXCode: Build Options**."
        },
        "VXCode.onlyTesting": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "markdownDescription": "Tests to run, each passed as `-only-testing:<value>` (`Target`, `Target/Class` or `Target/Class/testMethod`). A `*` in the class name, such as `AppTests/*SnapshotTests`, matches test classes found in the workspace. Empty runs the whole scheme."
        },
        "VXCode.skipTesting": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "markdownDescription": "Tests to skip, each passed as `-skip-testing:<value>`. Supports the same `*` class-name patterns as `VXCode.onlyTesting`."
        },
        "VXCode.additionalBuildArguments": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "markdownDescription": "Extra `xcodebuild` arguments appended to Build, Build and Run, Run tests and Clean, one array item per argument."
        },
        "VXCode.excludeDerivedData": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "When DerivedData is inside the workspace folder, add it to `files.watcherExclude` and `search.exclude` in that folder's settings so VS Code does not track build output."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "VXCode",
          "title": "VXCode",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "VXCode": [
        {
          "id": "VXCode.launch",
          "name": "Launch Center",
          "type": "webview"
        }
      ]
    },
    "languages": [
      {
        "id": "vxcode-output",
        "aliases": [
          "VXCode Output"
        ],
        "mimetypes": [
          "text/x-code-output"
        ]
      }
    ],
    "grammars": [
      {
        "language": "vxcode-output",
        "scopeName": "source.vxcode-output",
        "path": "./syntaxes/vxcode-output.tmLanguage.json"
      }
    ]
  },
  "icon": "media/vxcode-icon-greyscale.png",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "xcode",
    "ios",
    "swift",
    "simulator",
    "xcodebuild"
  ]
}
